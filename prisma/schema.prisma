generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
  EXPERT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventType {
  RANKED
  UNRANKED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  hash                 String?
  name                 String?
  profilePicture       String?
  communityMemberships CommunityMembership[]
  posts                Post[]
  verifications        Verification[]
  experiencePoints     ExperiencePoint[]
  followedSkillTrees   SkillTree[]           @relation("SkillTreeFollowers")
  customSkillForests   SkillForest[]
  leaderboardEntries   LeaderboardEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Community {
  id           String                @id @default(cuid())
  name         String                @unique
  slug         String                @unique
  description  String?
  icon         String?
  tags         String[]
  creatorId    String
  members      CommunityMembership[]
  skillTrees   SkillTree[]
  posts        Post[]
  leaderboards Leaderboard[]
  events       Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

model CommunityMembership {
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([communityId, userId])
  @@index([userId])
}

model SkillTree {
  id           String          @id @default(cuid())
  name         String
  description  String?
  communityId  String
  community    Community       @relation(fields: [communityId], references: [id])
  nodes        SkillTreeNode[]
  followers    User[]          @relation("SkillTreeFollowers")
  skillForests SkillForest[]   @relation("SkillForestTrees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
}

model SkillTreeNode {
  id              String          @id @default(cuid())
  skillTreeId     String
  skillTree       SkillTree       @relation(fields: [skillTreeId], references: [id])
  name            String
  description     String
  masteryCriteria String
  parentId        String?
  parent          SkillTreeNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        SkillTreeNode[] @relation("NodeHierarchy")
  Post            Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillTreeId])
}

model Post {
  id                 String             @id @default(cuid())
  content            String
  attachmentUrl      String?
  authorId           String
  author             User               @relation(fields: [authorId], references: [id])
  communityId        String
  community          Community          @relation(fields: [communityId], references: [id])
  skillTreeNodeId    String?
  skillTreeNode      SkillTreeNode?     @relation(fields: [skillTreeNodeId], references: [id])
  verifications      Verification[]
  verificationStatus VerificationStatus @default(PENDING)
  likes              Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([communityId])
  @@index([skillTreeNodeId])
}

model Verification {
  postId       String
  post         Post    @relation(fields: [postId], references: [id])
  verifierId   String
  verifier     User    @relation(fields: [verifierId], references: [id])
  feedbackText String?
  isApproved   Boolean
  weight       Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([postId, verifierId])
  @@index([verifierId])
}

model ExperiencePoint {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  communityId String
  amount      Int
  metric      String
  description String
  postId      String?
  eventId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([communityId])
}

model SkillForest {
  id          String      @id @default(cuid())
  name        String
  description String?
  creatorId   String
  creator     User        @relation(fields: [creatorId], references: [id])
  skillTrees  SkillTree[] @relation("SkillForestTrees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

model Leaderboard {
  id          String             @id @default(cuid())
  communityId String
  community   Community          @relation(fields: [communityId], references: [id])
  name        String
  metric      String
  entries     LeaderboardEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, name])
}

model LeaderboardEntry {
  leaderboardId String
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  rank          Int
  score         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([leaderboardId, userId])
  @@index([userId])
}

model Event {
  id               String    @id @default(cuid())
  name             String
  description      String?
  eventType        EventType @default(UNRANKED)
  communityId      String
  community        Community @relation(fields: [communityId], references: [id])
  experiencePayout Int?
  startTime        DateTime
  endTime          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
}
