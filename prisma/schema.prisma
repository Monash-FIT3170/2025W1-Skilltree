generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  dateOfBirth DateTime
  hash        String
  pfp         String   @default("")
  xpPoint     Int      @default(0)

  skillTrees    SkillTree[]
  skillTreeUser SkillTreeUser[]
  post          Post[]          @relation("PostLikes")
  feedback      Feedback[]
  event         Event[]         @relation("EventParticipants")
  winnerOf      Event[]
  skillNodeUser SkillNodeUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
}

model SkillTree {
  id          String @id @default(uuid())
  name        String
  description String @default("")

  skillNodes    SkillNode[]
  tags          Tag[]           @relation("SkillTreeTags")
  creator       User            @relation(fields: [creatorId], references: [id])
  creatorId     String
  skillTreeUser SkillTreeUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model SkillNode {
  id          String  @id @default(uuid())
  name        String
  description String?
  xpPoint     Int     @default(100)

  skillTree   SkillTree? @relation(fields: [skillTreeId], references: [id])
  skillTreeId String?

  parentNode    SkillNode?      @relation("SkillNodeParent", fields: [parentNodeId], references: [id])
  parentNodeId  String?
  childNode     SkillNode[]     @relation("SkillNodeParent")
  post          Post[]
  skillNodeUser SkillNodeUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([description])
}

model Post {
  id         String @id @default(uuid())
  content    String
  proofMedia String

  skillNode   SkillNode? @relation(fields: [skillNodeId], references: [id])
  skillNodeId String?
  likes       User[]     @relation("PostLikes")
  feedback    Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([content])
}

model SkillTreeUser {
  skillTree          SkillTree          @relation(fields: [skillTreeId], references: [id])
  skillTreeId        String
  user               User               @relation(fields: [userId], references: [id])
  userId             String
  role               Role               @default(MEMBER)
  verificationStatus VerificationStatus @default(PENDING)

  @@id([skillTreeId, userId])
}

model SkillNodeUser {
  skillNode   SkillNode @relation(fields: [skillNodeId], references: [id])
  skillNodeId String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  xpPoint     Int       @default(0)

  @@id([skillNodeId, userId])
}

model Feedback {
  verifier     User   @relation(fields: [verifierId], references: [id])
  verifierId   String
  post         Post   @relation(fields: [postId], references: [id])
  postId       String
  feedbackText String
  multiplier   Int    @default(1)

  @@id([verifierId, postId])
  @@index([feedbackText])
}

model Tag {
  id                     String  @id @default(uuid())
  name                   String  @unique
  isRestricted           Boolean @default(false)
  restrictionDescription String  @default("You are not allowed to view the SkillTree because of community restrictions.")

  skillTrees SkillTree[] @relation("SkillTreeTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Event {
  id        String   @id @default(uuid())
  title     String
  isRanked  Boolean  @default(false)
  xpPayout  Int      @default(0)
  users     User[]   @relation("EventParticipants")
  startDate DateTime @default(now())
  endDate   DateTime

  winner   User?   @relation(fields: [winnerId], references: [id])
  winnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([startDate])
}
