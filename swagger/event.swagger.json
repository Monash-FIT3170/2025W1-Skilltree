{
	"openapi": "3.0.0",
	"info": {
		"title": "Event API",
		"description": "Event management API endpoints",
		"version": "1.0.0"
	},
	"paths": {
		"/event": {
			"get": {
				"summary": "Get all events",
				"description": "Get a list of all events",
				"tags": ["Event"],
				"operationId": "getAllEvents",
				"responses": {
					"200": {
						"description": "List of events retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Event"
									}
								}
							}
						}
					},
					"500": {
						"description": "Internal server error"
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"Event": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid",
						"description": "Event ID"
					},
					"title": {
						"type": "string",
						"description": "Event title"
					},
					"isRanked": {
						"type": "boolean",
						"description": "Whether this is a ranked event"
					},
					"xpPayout": {
						"type": "integer",
						"description": "XP payout for the event"
					},
					"startDate": {
						"type": "string",
						"format": "date-time",
						"description": "Event start date and time"
					},
					"endDate": {
						"type": "string",
						"format": "date-time",
						"description": "Event end date and time"
					},
					"winnerId": {
						"type": "string",
						"format": "uuid",
						"description": "ID of the winner user",
						"nullable": true
					},
					"winner": {
						"$ref": "#/components/schemas/User",
						"nullable": true
					},
					"users": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/User"
						},
						"description": "Event participants"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time",
						"description": "Creation timestamp"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time",
						"description": "Last update timestamp"
					}
				}
			},
			"User": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid",
						"description": "User ID"
					},
					"name": {
						"type": "string",
						"description": "User's full name"
					},
					"email": {
						"type": "string",
						"format": "email",
						"description": "User's email address"
					},
					"pfp": {
						"type": "string",
						"description": "Profile picture URL"
					}
				}
			}
		},
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "Enter JWT Bearer token"
			}
		}
	}
}
