############################################
# Authentication
############################################

### User registration
POST http://localhost:3001/auth/signup
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john@doe.com",
  "password": "John@Doe@New@123",
  "dateOfBirth": "1990-01-01"
}

### User login
POST http://localhost:3001/auth/signin
Content-Type: application/json

{
  "email": "eve@example.com",
  "password": "passworddef"
}

### Get current user profile
GET http://localhost:3001/user/me
Authorization: Bearer {{bearerToken}}

### Change password
POST http://localhost:3001/auth/change-password
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "currentPassword": "JohnNew@123",
  "newPassword": "NewPassword@123"
}

### Request password reset
POST http://localhost:3001/auth/forgot-password
Content-Type: application/json

{
  "email": "john@doe.com"
}

### Refresh JWT token
POST http://localhost:3001/auth/refresh-token
Authorization: Bearer {{bearerToken}}

############################################
# User
############################################

### Get current user information
GET http://localhost:3001/user/me
Authorization: Bearer {{bearerToken}}

### Update user profile
PUT http://localhost:3001/user/profile
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "name": "John Updated",
  "dateOfBirth": "1990-01-01",
  "pfp": "https://example.com/profile.jpg"
}

### Get user by ID
GET http://localhost:3001/user/{{userId}}

### Get all users (leaderboard)
GET http://localhost:3001/user

### Get current user statistics
GET http://localhost:3001/user/stats/me
Authorization: Bearer {{bearerToken}}

### Get user statistics by ID
GET http://localhost:3001/user/stats/{{userId}}

############################################
# Posts - Public
############################################

### Get all posts (public)
GET http://localhost:3001/post

### Get post by ID (public)
GET http://localhost:3001/post/{{postId}}

############################################
# Posts - Authenticated
############################################

### Get all posts (authenticated)
GET http://localhost:3001/post/auth/all
Authorization: Bearer {{bearerToken}}

### Get post by ID (authenticated)
GET http://localhost:3001/post/auth/{{postId}}
Authorization: Bearer {{bearerToken}}

### Create a new post
POST http://localhost:3001/post
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "content": "This is the content of my first post",
  "proofMedia": "some media"
}

### Update post
PATCH http://localhost:3001/post/{{postId}}
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "content": "Updated content for the post"
}

### Delete post
DELETE http://localhost:3001/post/{{postId}}
Authorization: Bearer {{bearerToken}}

### Like a post
POST http://localhost:3001/post/{{postId}}/like
Authorization: Bearer {{bearerToken}}

### Unlike a post
DELETE http://localhost:3001/post/{{postId}}/like
Authorization: Bearer {{bearerToken}}

### Get post likes
GET http://localhost:3001/post/{{postId}}/likes

############################################
# SkillTree - Public
############################################

### Get all skill trees (public)
GET http://localhost:3001/skilltree

### Get skill tree by ID (public)
GET http://localhost:3001/skilltree/{{skillTreeId}}

############################################
# SkillTree - Authenticated
############################################

### Get all skill trees (authenticated)
GET http://localhost:3001/skilltree/auth/all
Authorization: Bearer {{bearerToken}}

### Get skill tree by ID (authenticated)
GET http://localhost:3001/skilltree/auth/{{skillTreeId}}
Authorization: Bearer {{bearerToken}}

### Create a new skill tree
POST http://localhost:3001/skilltree
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "name": "DS",
  "description": "DS means Data Science",
  "tagIds": [
    "67e24342-19cc-4ea5-8faf-e74899424521"
  ]
}

### Update skill tree
PATCH http://localhost:3001/skilltree/{{skillTreeId}}
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "name": "Updated Web Development",
  "description": "Updated description for web development skill tree",
  "tagIds": []
}

### Delete skill tree
DELETE http://localhost:3001/skilltree/{{skillTreeId}}
Authorization: Bearer {{bearerToken}}

############################################
# SkillTree - Membership
############################################

### Join a skill tree
POST http://localhost:3001/skilltree/{{skillTreeId}}/join
Authorization: Bearer {{bearerToken}}

### Leave a skill tree
DELETE http://localhost:3001/skilltree/{{skillTreeId}}/leave
Authorization: Bearer {{bearerToken}}

### Get skill tree members
GET http://localhost:3001/skilltree/{{skillTreeId}}/members
Authorization: Bearer {{bearerToken}}

### Update user role or verification status
PATCH http://localhost:3001/skilltree/{{skillTreeId}}/members/{{userId}}
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "role": "ADMIN",
  "verificationStatus": "VERIFIED"
}

### Remove user from skill tree
DELETE http://localhost:3001/skilltree/{{skillTreeId}}/members/{{userId}}
Authorization: Bearer {{bearerToken}}

############################################
# SkillTree - User
############################################

### Get my skill trees
GET http://localhost:3001/skilltree/user/my-skilltrees
Authorization: Bearer {{bearerToken}}

### Get user's skill trees
GET http://localhost:3001/skilltree/user/{{userId}}/skilltrees
Authorization: Bearer {{bearerToken}}



### Get all events
GET http://localhost:3001/event


